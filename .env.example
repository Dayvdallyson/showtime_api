NODE_ENV=development
PORT=3333
# Origens liberadas no CORS, separadas por vírgula
WEB_ORIGIN=http://localhost:5173,https://dayvdallyson.github.io
LOG_LEVEL=info

# Rate limit: no máximo RATE_LIMIT_MAX requisições por IP a cada RATE_LIMIT_WINDOW_MS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Quantos proxies confiáveis ficam na frente da API (0 = acesso direto)
TRUST_PROXY=0

POSTGRES_USER=showtime
POSTGRES_PASSWORD=showtime
POSTGRES_DB=showtime

DATABASE_URL="postgresql://showtime:showtime@localhost:5432/showtime?schema=public"

# Database separada usada pelos testes de integração (criada pelo próprio teste)
TEST_DATABASE_URL="postgresql://showtime:showtime@localhost:5432/showtime_test?schema=public"
